#!url=https://raw.githubusercontent.com/mottzz87/crules/refs/heads/main/module/surge/wetalk.sgmodule
#!name=WeTalk自动化
#!desc=WeTalk 自动签到+视频奖励 • 支持多账号\n定时任务：每天自动签到两次并自动观看视频领取奖励\n
#!category=🎉 Mottzz87
#!author=Mottzz87
#!homepage=https://github.com/mottzz87/crules
#!arguments=签到通知:true,抓包通知:true,视频通知:true,自动播放间隔:2,视频数量:5,视频间隔:8,早间几点:8,晚间几点:20,几分:20,统计几点:0,统计几分:5,域名:api.wetalkapp.com
#!arguments-desc=\n⚠️ 重要提示：如无特殊需求，无需修改参数，默认值即可良好运行。\n\n- 签到通知：定时签到完成后是否通知（失败时仍会通知）\n- 抓包通知：抓到新账号时是否通知\n- 视频通知：定时播放视频任务完成后是否通知（失败时仍会通知）\n- 自动播放间隔：视频自动播放任务每隔多少小时触发一次（默认2小时，调试时可设小值如5），循环所有账号播放视频\n- 视频数量：每次任务自动观看的视频数量(0-10)，0表示不观看\n- 视频间隔：每个视频之间的间隔秒数\n- 早间几点：早间签到时间(小时)\n- 晚间几点：晚间签到时间(小时)\n- 几分触发：签到触发分钟，用于错开高峰期\n- 统计几点：每日统计日报触发小时(默认0点)\n- 统计几分：每日统计日报触发分钟(默认5分)\n- 域名：API域名，默认api.wetalkapp.com\n使用步骤：\n1. 安装模块并开启 MitM\n2. 打开 WeTalk App 触发抓包入库\n3. 等待定时任务自动签到/播放视频\n手动签到：\n访问 https://{{{域名}}}/app/manual_checkin 触发\n\n
#!arguments-option=签到通知:true,false
#!arguments-option=抓包通知:true,false
#!arguments-option=视频通知:true,false
#!arguments-option=自动播放间隔:1,2,3,4
#!arguments-option=视频数量:0,3,5,8,10
#!arguments-option=视频间隔:3,5,8,10,15
#!arguments-option=早间几点:6,7,8,9,10
#!arguments-option=晚间几点:18,19,20,21,22
#!arguments-option=几分:16,20,25
#!arguments-option=统计几点:0,1,2,3,4,5
#!arguments-option=统计几分:0,5,10,15,20,25,30

[Script]
# 抓包入库（打开 WeTalk 自动触发）
WeTalk抓包 = type=http-request,timeout=60,pattern=^https:\/\/{{{域名}}}\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/mottzz87/crewrite/main/rewrite/wetalk/wetalk.js,argument=capturenotify={{{抓包通知}}}&domain={{{域名}}}

# 手动签到（访问 https://api.wetalkapp.com/app/manual_checkin 触发）
WeTalk手动签到 = type=http-request,timeout=300,pattern=^https?:\/\/{{{域名}}}\/app\/manual_checkin$,script-path=https://raw.githubusercontent.com/mottzz87/crewrite/main/rewrite/wetalk/wetalk.js,argument=checkinnotify=true&videonum={{{视频数量}}}&videodelay={{{视频间隔}}}&domain={{{域名}}}

# 自动签到（每天两次）
WeTalk自动签到 = type=cron,cronexp="{{{几分}}} {{{早间几点}}},{{{晚间几点}}} * * *",wake-system=1,timeout=300,script-path=https://raw.githubusercontent.com/mottzz87/crewrite/main/rewrite/wetalk/wetalk.js,argument=checkinnotify={{{签到通知}}}&videonum={{{视频数量}}}&videodelay={{{视频间隔}}}&domain={{{域名}}}

# 自动播放视频（每隔N小时，循环所有账号播放，不重复签到）
WeTalk自动播放 = type=cron,cronexp="0 */{{{自动播放间隔}}} * * *",wake-system=1,timeout=300,script-path=https://raw.githubusercontent.com/mottzz87/crewrite/main/rewrite/wetalk/wetalk.js,argument=mode=video&videonotify={{{视频通知}}}&videonum={{{视频数量}}}&videodelay={{{视频间隔}}}&domain={{{域名}}}

# 每日统计（近3天逐日 视频播放次数/成功次数与收益，默认 00:05 触发）
WeTalk每日统计 = type=cron,cronexp="{{{统计几分}}} {{{统计几点}}} * * *",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/mottzz87/crewrite/main/rewrite/wetalk/wetalk.js,argument=mode=stats&domain={{{域名}}}

[MITM]
hostname = %APPEND% {{{域名}}}
